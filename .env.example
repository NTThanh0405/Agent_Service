# Chép thành .env và điền. KHÔNG commit .env.
# Bí mật riêng của từng doanh nghiệp có thể đặt trong workspaces/<ten>/.env (cũng không commit).

# --- Workspace chạy mặc định (tên thư mục trong workspaces/ hoặc đường dẫn)
BIZAGENT_WORKSPACE=demo
# BIZAGENT_WORKSPACES_DIR=workspaces

# --- Model AI: chỉ cần key của nhà cung cấp đang dùng trong agents.yaml
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=

# --- Web: chat, dashboard sống, Power BI
BIZAGENT_HOST=127.0.0.1
BIZAGENT_PORT=8000
# Địa chỉ người dùng mở (dùng trong dashboards.yaml: public_url), vd https://bi.congty.vn
BIZAGENT_PUBLIC_URL=http://127.0.0.1:8000
# 1 = đứng sau Cloudflare Tunnel / Caddy / IIS / nginx (tin header X-Forwarded-*). Docker tự đặt 1.
BIZAGENT_BEHIND_PROXY=0
# Khoá ký phiên đăng nhập web. BẮT BUỘC khi nghe ngoài 127.0.0.1. Tạo như API token bên dưới.
BIZAGENT_SECRET_KEY=
# BẮT BUỘC khi nghe ngoài 127.0.0.1 (vd trong Docker). Tạo bằng: python -c "import secrets;print(secrets.token_urlsafe(32))"
BIZAGENT_API_TOKEN=
BIZAGENT_API_ROLE=admin

# --- Telegram (tuỳ chọn)
TELEGRAM_BOT_TOKEN=

# --- Slack (tuỳ chọn, bật trong channels.yaml; Request URL: <public_url>/slack/events)
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# --- Email (tuỳ chọn): gửi báo cáo định kỳ cho người nhận "email:ten@congty.vn" (xem docs/REPORTS.md)
# SMTP_HOST=smtp.gmail.com            # Microsoft 365: smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls              # starttls (587) | ssl (465) | none (25, chỉ mạng nội bộ)
# SMTP_USER=baocao@congty.vn
# SMTP_PASSWORD=                      # Gmail / Google Workspace: dùng App Password, không dùng mật khẩu đăng nhập
# SMTP_FROM="Báo cáo bizagent <baocao@congty.vn>"

# --- Power BI Service (tuỳ chọn): bizagent tự đẩy dữ liệu (dashboards.yaml: powerbi.push; xem docs/DASHBOARDS.md)
# Service principal Microsoft Entra ID: app registration + client secret, thêm vào workspace Power BI (Member)
# POWERBI_TENANT_ID=
# POWERBI_CLIENT_ID=
# POWERBI_CLIENT_SECRET=

# --- Zalo OA (tuỳ chọn, bật trong channels.yaml của workspace; xem docs/CHANNELS.md)
# ZALO_APP_ID=
# ZALO_APP_SECRET=
# ZALO_OA_SECRET_KEY=
# ZALO_REFRESH_TOKEN=
# ZALO_WEBHOOK_SECRET=

# --- Database của workspace (tên biến do sources.yaml quyết định), ví dụ:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

LOG_LEVEL=INFO
